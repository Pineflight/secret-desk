{
  "name": "secret-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first portal for tokens and secrets: see expiry, issue or renew tokens at providers and write them directly to the GitHub secret store. Values are never stored.",
  "license": "MIT",
  "repository": "github:Pineflight/secret-desk",
  "homepage": "https://github.com/Pineflight/secret-desk#readme",
  "bugs": "https://github.com/Pineflight/secret-desk/issues",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run test",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm --filter @secret-desk/desk run dev",
    "demo": "node scripts/demo.mjs",
    "build:libs": "pnpm --filter @secret-desk/core --filter @secret-desk/providers --filter @secret-desk/automation --filter @secret-desk/runtime --filter @secret-desk/cli --filter @secret-desk/mcp run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0"
  }
}
